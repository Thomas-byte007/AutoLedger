<?xml version="1.0" encoding="utf-8"?>
<!--
  「我的」页结构（自上而下）：
    1. 状态卡      —— 自动记账健康度 + 三个关键数字，只有一个主按钮
    2. 记账方式    —— 支付通知记账开关，其余收进「稳定运行」折叠区
    3. 常用工具    —— 2x2 网格，把四个最常点的功能平铺出来
    4. 更多        —— 诊断 / 系统设置类低频项，默认收起
    5. 清空数据    —— 唯一的破坏性操作，单独一张卡，视觉上刻意远离上面
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/gap_l"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="32dp">

        <!-- ========== 1. 状态卡 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/card_radius_lg"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:padding="@dimen/gap_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_title_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_translucent"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="@dimen/gap_m"
                        android:paddingTop="5dp"
                        android:paddingEnd="@dimen/gap_m"
                        android:paddingBottom="5dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="已开启" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:alpha="0.9"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    tools:text="微信 / 支付宝付款时会自动记账" />

                <!-- 三个关键数字：把低频的信息密度压在这一条里，避免再占一屏。
                     只靠细分隔线分区，不再叠一层半透明白块 —— 那层「半透明面板」是渐变卡
                     时代的遗留装饰，去掉之后整块墨蓝更干净。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/gap_m"
                    android:paddingTop="@dimen/gap_m"
                    android:paddingEnd="@dimen/gap_m"
                    android:paddingBottom="@dimen/gap_m">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMetricTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="128 笔" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/mine_metric_total"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider_translucent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/gap_m">

                        <TextView
                            android:id="@+id/tvMetricMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="¥1,208.00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/mine_metric_month"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider_translucent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/gap_m">

                        <TextView
                            android:id="@+id/tvMetricPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="3 笔" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/mine_metric_pending"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnGrant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l"
                    android:background="@drawable/bg_pill_white"
                    android:gravity="center"
                    android:minHeight="46dp"
                    android:paddingStart="@dimen/gap_l"
                    android:paddingTop="@dimen/gap_m"
                    android:paddingEnd="@dimen/gap_l"
                    android:paddingBottom="@dimen/gap_m"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    tools:text="去开启通知使用权" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== 2. 记账方式 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowCapture"
                    layout="@layout/row_switch" />

                <View style="@style/DividerRow" />

                <include
                    android:id="@+id/foldReliable"
                    layout="@layout/row_fold" />

                <LinearLayout
                    android:id="@+id/bodyReliable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <include
                        android:id="@+id/rowKeepAlive"
                        layout="@layout/row_switch" />

                    <View style="@style/DividerRow" />

                    <include
                        android:id="@+id/rowAccess"
                        layout="@layout/row_switch" />

                    <View style="@style/DividerRow" />

                    <include
                        android:id="@+id/rowBattery"
                        layout="@layout/row_action" />

                    <View style="@style/DividerRow" />

                    <include
                        android:id="@+id/rowRelink"
                        layout="@layout/row_action" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== 3. 常用工具 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/gap_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileCategories"
                        layout="@layout/row_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gap_xs"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileRules"
                        layout="@layout/row_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_xs"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileImport"
                        layout="@layout/row_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gap_xs"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileExport"
                        layout="@layout/row_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_xs"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== 4. 更多 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/foldMore"
                    layout="@layout/row_fold" />

                <LinearLayout
                    android:id="@+id/bodyMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <include
                        android:id="@+id/rowStats"
                        layout="@layout/row_action" />

                    <View style="@style/DividerRow" />

                    <include
                        android:id="@+id/rowLog"
                        layout="@layout/row_action" />

                    <View style="@style/DividerRow" />

                    <include
                        android:id="@+id/rowNotifyAccess"
                        layout="@layout/row_action" />

                    <View style="@style/DividerRow" />

                    <include
                        android:id="@+id/rowPrivacy"
                        layout="@layout/row_action" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== 5. 危险操作 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <include
                android:id="@+id/rowClear"
                layout="@layout/row_action" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            tools:text="随手记 v1.3.0" />

    </LinearLayout>
</ScrollView>
