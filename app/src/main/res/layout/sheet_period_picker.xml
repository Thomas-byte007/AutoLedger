<?xml version="1.0" encoding="utf-8"?>
<!--
  账单周期选择面板（BottomSheet）：
  报表页点月份标题时从底部滑出，可以「月 / 年」两种口径直接挑时间段 ——
  月：年份切换 + 12 宫格月份；年：直接挑年份，选中后打开年度账单。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_sheet_handle"
        android:importantForAccessibility="no" />

    <!-- 标题行：选择时间 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/picker_period_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- 月 / 年 切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTabMonth"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:gravity="center"
            android:text="@string/picker_period_month"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTabYear"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:gravity="center"
            android:text="@string/picker_period_year"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 年份切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btnPrevYear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_soft"
            android:contentDescription="@string/picker_period_prev_year"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/tvYearLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="2026年"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageButton
            android:id="@+id/btnNextYear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_soft"
            android:contentDescription="@string/picker_period_next_year"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- 月模式：12 宫格月份 / 年模式：年份列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <ScrollView
            android:id="@+id/scrollYears"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/yearContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/gridMonths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </FrameLayout>
</LinearLayout>
