<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏：返回 / 分类名 / 统计区间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_s"
        android:paddingEnd="@dimen/gap_l">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            tools:text="饮食" />

        <TextView
            android:id="@+id/tvPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            tools:text="2026年09月" />
    </LinearLayout>

    <!-- 概览：分类 / 金额 / 占比 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginEnd="@dimen/page_padding"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/card_radius_lg"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/heroIconBg"
                    android:layout_width="@dimen/icon_badge"
                    android:layout_height="@dimen/icon_badge"
                    android:background="@drawable/shape_circle">

                    <ImageView
                        android:id="@+id/heroIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_cat_dining" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvGroupName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_m"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="饮食" />

                <TextView
                    android:id="@+id/tvGroupRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="占支出 32.4%" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:textSize="@dimen/text_hero"
                android:textStyle="bold"
                tools:text="¥296.93" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:alpha="0.85"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="共 12 笔 · 日均 ¥9.90" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 二级分类构成 -->
    <TextView
        android:id="@+id/tvLeafTitle"
        style="@style/PickerSectionTitle"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginEnd="@dimen/page_padding"
        android:text="@string/breakdown_leaf_title" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/leafCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginEnd="@dimen/page_padding"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/leafContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="@dimen/gap_s"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="@dimen/gap_s" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 交易明细 -->
    <TextView
        android:id="@+id/tvDetailTitle"
        style="@style/PickerSectionTitle"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginEnd="@dimen/page_padding"
        android:text="@string/breakdown_txn_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/gap_l" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/gap_xxl"
        android:paddingEnd="@dimen/page_padding"
        android:text="@string/breakdown_empty"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_small"
        android:visibility="gone" />

</LinearLayout>
