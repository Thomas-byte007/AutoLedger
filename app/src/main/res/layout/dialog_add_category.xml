<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- 预览 + 名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/gap_s">

            <FrameLayout
                android:id="@+id/previewBg"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/shape_circle">

                <ImageView
                    android:id="@+id/previewIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_cat_dining" />
            </FrameLayout>

            <EditText
                android:id="@+id/etName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:background="@drawable/bg_round_soft_filled"
                android:hint="@string/picker_add_name_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="6"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGroupTitle"
            style="@style/PickerSectionTitle"
            android:text="@string/picker_add_group" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="2dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/PickerSectionTitle"
            android:text="@string/picker_add_icon" />

        <GridLayout
            android:id="@+id/iconGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7" />

        <TextView
            style="@style/PickerSectionTitle"
            android:text="@string/picker_add_color" />

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="8" />
    </LinearLayout>
</ScrollView>
