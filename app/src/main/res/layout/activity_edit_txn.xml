<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== 顶栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_s"
        android:paddingEnd="@dimen/gap_l">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/quick_entry_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_delete_record"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trash"
            android:visibility="gone"
            app:tint="@color/expense_red" />

        <FrameLayout
            android:id="@+id/btnSave"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_save">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_primary"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== 收支方向 ===== -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabDirection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/brand_primary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabPaddingBottom="4dp"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextAppearance="@style/EntryTabText"
        app:tabTextColor="@color/text_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="@dimen/gap_m"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="@dimen/gap_m">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 金额 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/tvCurrency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/currency_symbol"
                            android:textColor="@color/text_primary"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAmount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            tools:text="128.50" />

                        <TextView
                            android:id="@+id/tvDirectionTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_round_soft_filled"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            tools:text="支出" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:alpha="0.35"
                        android:background="@color/brand_primary" />

                    <!-- 分类 -->
                    <LinearLayout
                        android:id="@+id/rowCategory"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="?android:selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_grid"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/field_category"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/tvCategory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            tools:text="饮食 › 零食" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/divider" />

                    <!-- 账户 -->
                    <LinearLayout
                        android:id="@+id/rowAccount"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="?android:selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/field_account"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/tvAccount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_subtitle"
                            tools:text="现金" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/divider" />

                    <!-- 时间 -->
                    <LinearLayout
                        android:id="@+id/rowTime"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="?android:selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/field_time"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_subtitle"
                            tools:text="今天 9月14日 12:52" />

                        <ImageButton
                            android:id="@+id/btnNow"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?android:selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_now"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_close"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/divider" />

                    <!-- 交易对方 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/field_merchant"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body" />

                        <EditText
                            android:id="@+id/etMerchant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/field_merchant_hint"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="30"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="@dimen/text_subtitle" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/divider" />

                    <!-- 备注 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_note"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/field_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body" />

                        <EditText
                            android:id="@+id/etNote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/field_note_hint"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="60"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="@dimen/text_subtitle" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 记住商户 -->
            <LinearLayout
                android:id="@+id/rowRemember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_round_soft_filled"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_l"
                android:paddingTop="@dimen/gap_m"
                android:paddingEnd="@dimen/gap_xs"
                android:paddingBottom="@dimen/gap_m"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/remember_merchant"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swRemember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 来源信息 -->
            <TextView
                android:id="@+id/tvSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_xs"
                android:layout_marginTop="@dimen/gap_m"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== 数字键盘（替代系统输入法，参考「记一笔」的交互） ===== -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="252dp"
        android:background="?android:colorBackground"
        android:orientation="horizontal"
        android:padding="5dp">

        <GridLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:columnCount="3"
            android:rowCount="4">

            <TextView
                android:id="@+id/key7"
                style="@style/KeypadKey"
                android:text="7" />

            <TextView
                android:id="@+id/key8"
                style="@style/KeypadKey"
                android:text="8" />

            <TextView
                android:id="@+id/key9"
                style="@style/KeypadKey"
                android:text="9" />

            <TextView
                android:id="@+id/key4"
                style="@style/KeypadKey"
                android:text="4" />

            <TextView
                android:id="@+id/key5"
                style="@style/KeypadKey"
                android:text="5" />

            <TextView
                android:id="@+id/key6"
                style="@style/KeypadKey"
                android:text="6" />

            <TextView
                android:id="@+id/key1"
                style="@style/KeypadKey"
                android:text="1" />

            <TextView
                android:id="@+id/key2"
                style="@style/KeypadKey"
                android:text="2" />

            <TextView
                android:id="@+id/key3"
                style="@style/KeypadKey"
                android:text="3" />

            <TextView
                android:id="@+id/keyDot"
                style="@style/KeypadKey"
                android:text="." />

            <TextView
                android:id="@+id/key0"
                style="@style/KeypadKey"
                android:text="0" />

            <ImageButton
                android:id="@+id/keyBackspace"
                style="@style/KeypadKey"
                android:contentDescription="@string/keypad_backspace"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_backspace"
                app:tint="@color/text_primary" />
        </GridLayout>

        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/keyMinus"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_key_ripple"
                android:contentDescription="@string/keypad_minus"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minus"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/keyPlus"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_key_ripple"
                android:contentDescription="@string/keypad_plus"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="3dp"
                android:layout_weight="1.6"
                android:background="@drawable/bg_keypad_confirm"
                android:gravity="center"
                android:text="@string/keypad_confirm"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
