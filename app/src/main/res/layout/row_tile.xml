<?xml version="1.0" encoding="utf-8"?>
<!-- 「常用工具」网格里的一个格子：图标在上、标题在下，副标题放一句话说明或数量 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile"
    android:minHeight="92dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/gap_m"
    android:paddingTop="@dimen/gap_m"
    android:paddingEnd="@dimen/gap_m"
    android:paddingBottom="@dimen/gap_m">

    <FrameLayout
        android:id="@+id/iconBg"
        android:layout_width="@dimen/icon_badge_sm"
        android:layout_height="@dimen/icon_badge_sm"
        android:background="@drawable/shape_circle">

        <ImageView
            android:id="@+id/tvIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_grid" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="分类管理" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="28 个分类" />
    </LinearLayout>

</LinearLayout>
