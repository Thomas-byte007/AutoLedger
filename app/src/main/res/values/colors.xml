<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== 品牌 / 中性色 =====
         主色走「沉稳可信」的蓝：把饱和度从 91% 降到 58%、色相从偏紫的 222° 挪到 218°。
         记账工具的彩色预算应该留给金额（支出红 / 收入绿）和分类，品牌色本身克制一点，
         整屏才不像模板渲染出来的图表页。 -->
    <color name="brand_primary">#3163B9</color>
    <color name="brand_container">#E4EBF6</color>
    <color name="brand_on_container">#204179</color>

    <!-- 页面底色改用中性灰：之前那层淡紫灰（#F4F6FB）整套界面都泛蓝紫，是最扎眼的一处 -->
    <color name="bg_page">#F5F6F8</color>
    <color name="surface_card">#FFFFFF</color>
    <color name="surface_variant">#EFF0F3</color>
    <color name="divider">#E6E7EB</color>

    <color name="text_primary">#16181D</color>
    <!-- 次要文字从 #8A93A6 压深到 #5A616E：原来的对比度只有 3.1:1，达不到 4.5:1 -->
    <color name="text_secondary">#5A616E</color>
    <color name="text_tertiary">#6F7680</color>

    <color name="expense_red">#C93A36</color>
    <color name="income_green">#27A571</color>

    <!-- 顶部概览卡：扁平单色墨蓝，不用渐变、不用高光 —— 渐变卡是「AI 生成感」最重的元素 -->
    <color name="hero_ink">#2C3D59</color>
    <!-- 墨蓝卡上的次级文字色（月份、说明串），比纯白低一档 -->
    <color name="hero_text_soft">#C6D4E8</color>

    <!-- ===== 分类色 =====
         同一个色族 = 同一个一级类。色相按 11 个一级类在色环上均匀铺开，
         全部收在 14%~70% 饱和度、32%~66% 明度这一条带里，二级类只跟着所属一级类
         微调明度，所以一屏名单看起来是「设计过的一套」，而不是一堆随机高饱和色。 -->
    <color name="cat_dining">#C6612F</color>
    <color name="cat_transport">#317FC4</color>
    <color name="cat_shopping">#BF36BF</color>
    <color name="cat_grocery">#31B99E</color>
    <color name="cat_housing">#6938BC</color>
    <color name="cat_entertainment">#C6A02F</color>
    <color name="cat_medical">#C4316E</color>
    <color name="cat_education">#3648BF</color>
    <color name="cat_travel">#2368A4</color>
    <color name="cat_transfer">#93A1AE</color>
    <color name="cat_other">#7F8F9F</color>
    <color name="cat_salary">#2DA967</color>
    <color name="cat_refund">#25985B</color>
    <color name="cat_other_income">#1F8951</color>

    <!-- ===== 二级类：沿用所属一级类的色相，只微调明度 ===== -->
    <color name="cat_snack">#CD774C</color>
    <color name="cat_drink">#B55626</color>
