<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoLedger" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_container</item>
        <item name="colorTertiary">@color/brand_primary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/brand_container</item>
        <item name="colorOnTertiaryContainer">@color/brand_on_container</item>
        <item name="colorError">@color/expense_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface_card</item>
        <item name="colorSurfaceContainerLow">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_card</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.AutoLedger.Card</item>
    </style>

    <style name="Widget.AutoLedger.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Amount" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.AutoLedger.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="Widget.AutoLedger.Button" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AutoLedger.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
